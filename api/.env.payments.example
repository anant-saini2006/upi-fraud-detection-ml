# Razorpay Payment Integration — Environment Variables
# Copy the values below into your actual .env or .env.local file.
# NEVER commit real secrets to version control.

# Razorpay API credentials (from Dashboard → Settings → API Keys)
# Use TEST mode keys for development; generate separate LIVE keys after activation.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Razorpay webhook secret (Dashboard → Webhooks → edit → Secret)
# This is NOT the same as the API key secret.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Frontend: set this in the Next.js environment (.env.local inside frontend/)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
