# FastAPI service (local defaults shown)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Mandatory for Gateway and Admin persistence: Neon / PostgreSQL pooled connection string.
# Example: postgresql://neondb_owner:***@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Gateway API test key (used by checkout and client calls)
GATEWAY_TEST_KEY=sk_test_demo_key_001

# Admin Console Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=demo1234

# Next.js frontend. Copy this value to frontend/.env.local for local work, and
# set it in Vercel to the deployed FastAPI HTTPS URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GATEWAY_KEY=sk_test_demo_key_001
