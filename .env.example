# FastAPI service (local defaults shown)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: Neon / PostgreSQL persistence. Leave blank to run the API without
# durable prediction history.
DATABASE_URL=

# Next.js frontend. Copy this value to frontend/.env.local for local work, and
# set it in Vercel to the deployed FastAPI HTTPS URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
